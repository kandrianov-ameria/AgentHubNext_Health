# Template only - no values. This file lists the CREDENTIALS the suite needs.
# Generate the real .env with:
#   .venv\Scripts\python scripts\refresh_env.py [path-to-agent-hub-backend]
# Any variable set in the real environment overrides .env.
#
# Addresses, the environment name, timeouts and other non-secret settings are
# in suite.env, which is committed to the repository.

AIHUB_WIN_TOKEN=
STARKIT_API_KEY=
AIHUB_DEVICE_MAPPING_TOKEN=
SEQ_API_KEY=

# Optional. Empty means no auth header is sent.
TWO_D_TO_3D_BASIC_AUTH=
TWO_D_TO_VIDEO_BASIC_AUTH=
