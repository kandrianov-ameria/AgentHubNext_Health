# AgentHubNext health suite - shared, non-secret settings.
#
# This file is committed to the repository. It holds NO credentials.
# Credentials live only in .env (gitignored, generated by scripts/refresh_env.py).
#
# Order of precedence, highest first:
#   1. a real environment variable (and --env on run_tests.bat for AGENTHUB_ENV)
#   2. .env  (a value set there overrides this file on your PC only)
#   3. this file
#   4. the built-in default in agenthub_health/settings.py

# ---- environment --------------------------------------------------------
# DEV / QAS / STG / PRD. run_tests.bat --env NAME overrides it for one run.
AGENTHUB_ENV=QAS

# ---- service base URLs ----------------------------------------------------
# Taken from the constants in agent-hub-backend. scripts/refresh_env.py
# re-reads them from the source and updates this block when they change.
AIHUB_SERVICE_BASE_URL=https://aihub.ameriadev.de/ai-hub-service
MAV_STARKIT_BASE_URL=https://aihub.ameriadev.de/mav-starkit-api
TWO_D_TO_3D_BASE_URL=https://aihub.ameriadev.de/2d-to-3d
TWO_D_TO_VIDEO_BASE_URL=https://aihub.ameriadev.de/2d-to-video
DEVICE_MAPPING_BASE_URL=https://aihub.ameriadev.de/ai-hub-service/api
SEQ_BASE_URL=https://seq.ameria.de

# ---- public third-party APIs ------------------------------------------------
# Deepgram's public REST API (the Deepgram SDK in the app talks to it).
DEEPGRAM_API_URL=https://api.deepgram.com
# Hardcoded in mcp-tavily-search-image/dist/index.js (tavilySearch).
TAVILY_SEARCH_URL=https://api.tavily.com/search

# ---- request timeouts (seconds) ---------------------------------------------
AGENTHUB_HEALTH_TIMEOUT=20
AGENTHUB_HEALTH_LLM_TIMEOUT=60
AGENTHUB_HEALTH_GENERATION_TIMEOUT=900
# The app's own timeout for every configuration download (20 s).
AGENTHUB_HEALTH_CONFIG_TIMEOUT=20

# ---- logs -------------------------------------------------------------------
# How many run folders logs/ keeps.
AGENTHUB_HEALTH_LOG_RUNS=5
